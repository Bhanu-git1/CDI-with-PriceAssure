# Salesforce Connection Settings
SF_USERNAME=your_salesforce_username@example.com
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token_here
SF_DOMAIN=login  # Use 'login' for production, 'test' for sandbox

# Optional: Session-based auth (for Salesforce embedded context)
# SF_SESSION_ID=
# SF_INSTANCE_URL=https://your-instance.salesforce.com

# LLM Providers Configuration
# To use Gemini, provide the API key below.
# To use local Ollama, leave GEMINI_API_KEY empty.
GEMINI_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434

# Backend API Settings
PORT=8000
HOST=0.0.0.0
