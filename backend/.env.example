# =====================================================================
# DATA SOURCE CREDENTIALS
#
# Each data source declared in app/semantic/datasources.yaml references the
# NAMES of the variables below. Every source MUST use a distinct prefix:
# .env is last-key-wins, so reusing MYSQL_* for a second database silently
# repoints the first one (including where chat history is written).
# =====================================================================

# --- DB 1: Commercial / Pharma Command Centre (source id: mysql_primary) ---
# Also stores chat transcripts, so this connection is not read-only.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name

# --- DB 2: GPO Customer Roster Validation (source id: mysql_gpo) ---
# Declared read_only in the manifest, which puts every connection into a
# read-only transaction. A SELECT-only database user is still recommended.
# Omit this block to run with DB 2 disabled — the source is skipped with a
# warning and the other sources work normally.
GPO_MYSQL_HOST=localhost
GPO_MYSQL_PORT=3306
GPO_MYSQL_USER=your_readonly_username
GPO_MYSQL_PASSWORD=your_readonly_password
GPO_MYSQL_DATABASE=gpo

# LLM Provider Configuration (Groq GPT-OSS 120B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Claude via AWS Bedrock (used if GROQ_API_KEY is unset) ---
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=ap-south-1
# BEDROCK_CLAUDE_MODEL=global.anthropic.claude-opus-5

# --- Claude direct Anthropic API (used if neither of the above is set) ---
# CLAUDE_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-opus-5

# Salesforce Connection Settings (UC3)
SF_USERNAME=your_salesforce_username@example.com
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token_here
SF_DOMAIN=login

# Optional: Session-based auth (for Salesforce embedded context)
# SF_SESSION_ID=
# SF_INSTANCE_URL=https://your-instance.salesforce.com

# Backend API Settings
PORT=8000
HOST=0.0.0.0
