# MySQL Connection Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database_name

# LLM Provider Configuration (Groq Llama 3.3)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Salesforce Connection Settings (UC3)
SF_USERNAME=your_salesforce_username@example.com
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token_here
SF_DOMAIN=login

# Optional: Session-based auth (for Salesforce embedded context)
# SF_SESSION_ID=
# SF_INSTANCE_URL=https://your-instance.salesforce.com

# Backend API Settings
PORT=8000
HOST=0.0.0.0
